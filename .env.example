# Copy to .env and fill in. Never commit .env — the repository is public.

# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs of the permanent admins
DEFAULT_ADMIN_ID=

# Timezone for working hours, daily notifications and the weekly report
USER_TIMEZONE=Europe/Kyiv

# Local MongoDB (docker compose). Any characters work in the password; if it
# contains $, wrap the value in single quotes.
MONGO_ROOT_USERNAME=comfy
MONGO_ROOT_PASSWORD=
MONGODB_DB_NAME=comfy_notifier

# Only for running the bot outside Docker (npm run dev) with MongoDB started via
# docker-compose.dev.yml. No credentials here — MONGO_ROOT_* above are used.
MONGODB_URI=mongodb://127.0.0.1:27017/
# MONGO_HOST_PORT=27017   # dev only, if 27017 is taken on your machine

# One-off migration from MongoDB Atlas (docker compose --profile migrate run --rm migrate).
# Remove after migrating.
ATLAS_URI=
